{
  "expo": {
    "name": "Perun",
    "slug": "perun",
    "version": "1.15.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.logos.perun",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Perun records your route while you run.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Perun keeps recording your route when the screen is off.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "co.logos.perun",
      "versionCode": 21,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0d1013",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "perun",
    "plugins": [
      "./plugins/withLogosDelivery",
      "./plugins/withForegroundService.js",
      "./plugins/withReleaseSigning",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Perun records your route while you run."
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Perun scans the pairing QR shown by your Basecamp.",
          "recordAudioAndroid": false
        }
      ],
      "./src/lib/logos-transport-pkg/plugins/withDeliveryClient.js",
      "./plugins/withLocationService"
    ]
  }
}