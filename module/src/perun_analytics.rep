// View contract for the Perun Analytics UI module. QML gets a typed replica of
// this via logos.module("perun_analytics"): PROPs auto-sync, SLOTs are callable.
class PerunAnalytics
{
    // Human-readable status line (bootstrap → connection → ready).
    PROP(QString status="Starting…" READONLY)

    // True once the delivery node is up and subscribed.
    PROP(bool ready=false READONLY)

    // 3-word pairing fingerprint (pgp words) of the shared secret. Shown so the
    // user can confirm it matches the phone. NOT the raw topic — that is
    // secret-adjacent and must never be displayed.
    PROP(QString fingerprint="" READONLY)

    // perun://pair?s=<base32-secret> — encoded into the pairing QR the phone
    // scans. Sensitive (it IS the secret); rendered only as a QR, never as text.
    PROP(QString pairingUri="" READONLY)

    // JSON array of run summaries for the list view, e.g.
    // [{ "id","name","startTs","summary":{…},"splits":[…] }, …]
    PROP(QString runsJson="[]" READONLY)

    // Publish a synthetic run (as gzipped GPX, chunked) over Logos Delivery —
    // stand-in for the mobile app. Returns "" on success, or an error.
    SLOT(QString publishSampleRun())

    // Decoded track points for a run, as JSON [{lat,lon,alt,hr,t}, …] (for the
    // route map). Empty array if unknown.
    SLOT(QString trackJson(QString runId))

    // Write the run out as a .gpx file; returns the file path ("" on error).
    SLOT(QString exportGpx(QString runId))

    // Generate a NEW pairing secret (unpairs every currently-paired phone) and
    // resubscribe to the new derived topic. Returns "" on success, else an error.
    SLOT(QString resetPairing())

    // Encode text as a QR matrix in-process (vendored Nayuki encoder — no
    // external qr module / IPC). Returns JSON {"ok":true,"n":<size>,"cells":[0|1,…]}
    // (row-major), or {"ok":false,"error":…}. Rendered as a grid in the QML.
    SLOT(QString qrMatrix(QString text))


    // Point the tile cache at a directory the QML sandbox can read: the view
    // passes Qt.resolvedUrl("."), i.e. the plugin's own qml dir. Call once
    // before any ensureTile(); without it tiles land in the data dir and the
    // sandbox blocks them.
    SLOT(QString setTileRoot(QString dirUrl))

    // Fetch an OSM raster basemap tile (Web-Mercator z/x/y), cache it under
    // <tileRoot>/tiles and return a file:// URL to the PNG. Fetched at most
    // once, with the OSM-mandated User-Agent; returns "" if it can't be had
    // (offline / HTTP error / bad coords) so the QML falls back to the plain
    // track.
    //
    // MUST be a file:// URL, NOT a data: URI. QQuickImage routes a data: URI
    // through the QNetworkAccessManager, which this engine has disabled:
    //   "QML QQuickImage: Network access disabled for this QML engine"
    // A file:// source is read straight off disk with no network involved — so
    // the only requirement is that the path sits inside the plugin sandbox.
    // Additive SLOT — does not touch the delivery/track contract above.
    SLOT(QString ensureTile(int z, int x, int y))
}
